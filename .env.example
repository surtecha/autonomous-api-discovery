# Hosted: openai + LLM_MODEL + OPENAI_API_KEY.
# Local: ollama + LLM_MODEL=qwen2.5:7b; no API key required.
# CLI: --env-file .env --llm-provider ollama --llm-model qwen2.5:7b
LLM_PROVIDER=openai
LLM_MODEL=<configured-model>
OPENAI_API_KEY=
DATABASE_URL=
BACKEND_API_TOKEN=
POSTGRES_PASSWORD=
MAX_REQUESTS_PER_SESSION=100
MAX_SESSION_DURATION_SECONDS=120
WEB_USERNAME=
WEB_PASSWORD=
BACKEND_URL=http://127.0.0.1:8000
API_PORT=8000
WEB_PORT=3000
WEB_ORIGIN=http://127.0.0.1:3000
DISCOVERY_TELEMETRY=off
